# n8n / Trimble Flows credentials — copy to .env and fill in (do not commit .env)

# Live sync uses the production webhook only (not the executions API).
# Optional: host / workflow id for /api/health display; API key only if webhook also expects X-N8N-API-KEY.
N8N_HOST=flows.stage.trimble-ai.com
N8N_API_KEY=
N8N_WORKFLOW_ID=LqRIsl66FSC8Nj8Q

# Webhook host + path (from n8n Webhook node Production URL). Keep the real id in .env only.
N8N_WEBHOOK_HOST=flows-webhook.stage.trimble-ai.com
N8N_WEBHOOK_PATH=/agentic/workflows/v1/webhook/<webhook-id>
N8N_WEBHOOK_TEST_PATH=/agentic/workflows/v1/webhook-test/<webhook-id>

# Incomplete-reminder mail workflow production path
# Example: /agentic/workflows/v1/webhook/<uuid>
N8N_MAIL_WEBHOOK_PATH=

# Trimble ID (stage) — client credentials for webhook gateway JWT (has kid)
# Server-only (n8n). Do NOT expose the secret to the browser.
TID_TOKEN_URL=https://stage.id.trimblecloud.com/oauth/token
TID_CLIENT_ID=
TID_CLIENT_SECRET=
TID_SCOPE=Agentic-N8N-Webhook

# ---------------------------------------------------------------------------
# Trimble ID — React SPA user login (@trimble-oss/trimble-id-react)
# Use a SEPARATE Developer Console app (Authorization Code + refresh tokens).
# VITE_* values are exposed to the browser — never put a client secret here.
#
# Where to find values:
# - Client ID: Developer Console → your app → Basic Information
# - Scope: same page / app name as {uuid}-{appName} (also add openid)
# - Configuration endpoint (not on every console page — use environment URL):
#     Stage: https://stage.id.trimblecloud.com/.well-known/openid-configuration
#     Prod:  https://id.trimble.com/.well-known/openid-configuration
# Register redirect + logout URLs on the TID app to match below.
# ---------------------------------------------------------------------------
VITE_TID_CONFIGURATION_ENDPOINT=https://stage.id.trimblecloud.com/.well-known/openid-configuration
VITE_TID_CLIENT_ID=
# Paths are rewritten to the current origin at runtime (so port 3000/3001 stay in sync).
# Dev server uses HTTPS (required for Trimble Assist iframe CSP). Register:
#   https://localhost:3000/callback
#   https://localhost:3000/logout-callback
VITE_TID_REDIRECT_URL=https://localhost:3000/callback
VITE_TID_LOGOUT_REDIRECT_URL=https://localhost:3000/logout-callback
# openid + your SPA application scope from Developer Console.
# Prefer `{application_uuid}-{ApplicationName}` for the app scope (sets token aud).
VITE_TID_SCOPES=openid
# Assist SDK scopes merged into the login request (docs: models + skills for
# skill-based agents). SPA app must be allowed to request them in Developer Console.
VITE_ASSIST_API_SCOPE=models,skills

# ---------------------------------------------------------------------------
# Trimble Assist / Agent Studio embed (checklist audit skill)
# Agent UUID: Agent Studio → your agent → details / Try in Assist.
# Packages: copy .npmrc.example → .npmrc with Artifactory Identity Token,
# then: npm install @trimble-agentic-external-npm-local/agentic-platform-sdk-iframe-typescript@latest --save-exact
# (Use the iframe SDK — agentic-chat-react 2.0.0 crashes in Vite with require("react").)
# Docs pack: https://drive.google.com/drive/folders/1ZdqPkrKkborWIB899EDqInYQilmco3lQ
#
# Embed only works from HTTPS parents. `npm run dev` serves https://localhost:3000
# (self-signed). Accept the browser warning; keep TID redirects on https:// too.
#
# Auth: Run Checklist passes the dashboard Trimble ID *access* token into Assist.
# If Assist shows "Sign in required", the token aud/scope is wrong — set
# VITE_ASSIST_API_SCOPE (or extend VITE_TID_SCOPES), restart, sign out/in.
# ---------------------------------------------------------------------------
VITE_ASSIST_AGENT_ID=
VITE_ASSIST_ENVIRONMENT=stage

# Must match n8n Header Auth credential (Name + Value)
N8N_WEBHOOK_HEADER_NAME=X-Control-Sheet-Token
N8N_WEBHOOK_HEADER_VALUE=
