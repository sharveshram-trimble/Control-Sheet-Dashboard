# n8n / Trimble Flows credentials — copy to .env and fill in (do not commit .env)

# API host (executions / workflow UI)
N8N_HOST=flows.stage.trimble-ai.com
N8N_API_KEY=
N8N_WORKFLOW_ID=LqRIsl66FSC8Nj8Q

# Webhook host + path (from n8n Webhook node Production URL)
N8N_WEBHOOK_HOST=flows-webhook.stage.trimble-ai.com
N8N_WEBHOOK_PATH=/agentic/workflows/v1/webhook/2c05024d-a533-4f74-92bd-3c99c88095b4
N8N_WEBHOOK_TEST_PATH=/agentic/workflows/v1/webhook-test/2c05024d-a533-4f74-92bd-3c99c88095b4

# Incomplete-reminder mail workflow production path
# Example: /agentic/workflows/v1/webhook/<uuid>
N8N_MAIL_WEBHOOK_PATH=

# Trimble ID (stage) — client credentials for webhook gateway JWT (has kid)
TID_TOKEN_URL=https://stage.id.trimblecloud.com/oauth/token
TID_CLIENT_ID=
TID_CLIENT_SECRET=
TID_SCOPE=Agentic-N8N-Webhook

# Optional: paste a short-lived access_token for local testing (Bearer …).
# Prefer TID_CLIENT_ID / TID_CLIENT_SECRET so the server can refresh automatically.
# Do NOT put the n8n API key JWT here (missing kid → gateway 401).
N8N_WEBHOOK_AUTH=

# Must match n8n Header Auth credential (Name + Value)
N8N_WEBHOOK_HEADER_NAME=X-Control-Sheet-Token
N8N_WEBHOOK_HEADER_VALUE=control-sheet-live-secret
